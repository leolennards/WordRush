rules_version = '2';

// Wordskiis — Firestore security rules.
// Players sign in anonymously. Every rule below limits what a signed-in
// player may read or write; nothing is readable or writable without auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function validCode(c) { return c is string && c.matches('^[346789ABCDEFGHJKMNPQRTUVWXY]{6}$'); }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/players/$(a)/friends/$(b));
    }
    function validLook(x) { return x == null || (x is string && x.matches('^[a-z]{1,12}$')); }
    function validDaily(d) {
      return d == null || (
        d is map
        && d.keys().hasOnly(['dayIndex', 'status', 'rows', 'streak'])
        && d.dayIndex is int
        && d.status in ['playing', 'won', 'lost']
        && d.rows is list && d.rows.size() <= 6
        && d.streak is int && d.streak >= 0
      );
    }

    // ---- Friend codes: one document per code, pointing at its owner. ----
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow update: if false;
      // Owners may release their code when deleting their profile.
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---- Public player profiles (name, code, today's spoiler-free result). ----
    match /players/{uid} {
      // Readable one at a time by id; nobody can list or search all players.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdAt', 'daily', 'frame', 'badge'])
        && validName(request.resource.data.name)
        && validCode(request.resource.data.code)
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid
        && validDaily(request.resource.data.get('daily', null));
      allow update: if signedIn() && me() == uid
        && onlyChanged(['name', 'daily', 'frame', 'badge'])
        && validName(request.resource.data.name)
        && validDaily(request.resource.data.get('daily', null))
        && validLook(request.resource.data.get('frame', null))
        && validLook(request.resource.data.get('badge', null));
      // "Delete my profile" (required by the app stores).
      allow delete: if signedIn() && me() == uid;

      // Friend list. Adding by code writes both sides: my list, and theirs.
      match /friends/{friendUid} {
        allow read: if signedIn() && me() == uid;
        allow create: if signedIn() && uid != friendUid
          && (me() == uid || me() == friendUid)
          && request.resource.data.keys().hasOnly(['since'])
          && exists(/databases/$(database)/documents/players/$(uid))
          && exists(/databases/$(database)/documents/players/$(friendUid));
        // Either friend can end the friendship (both sides are removed).
        allow delete: if signedIn() && (me() == uid || me() == friendUid);
        allow update: if false;
      }
    }

    // ---- Cloud save: one private document per Google account. ----
    // Guests can't use it: progress only syncs once you sign in with Google.
    function withGoogle() {
      return signedIn() && 'google.com' in request.auth.token.firebase.identities;
    }
    function smallString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    match /saves/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list: if false;
      allow create, update: if withGoogle() && me() == uid
        && request.resource.data.keys().hasOnly(['v', 'devices', 'wallet', 'owned', 'shared', 'dailyStats', 'practiceStats', 'daily', 'wordbook', 'sessions', 'updatedAt'])
        && (!('sessions' in request.resource.data) || (request.resource.data.sessions is map && request.resource.data.sessions.size() <= 16))
        && request.resource.data.v == 1
        && request.resource.data.devices is map && request.resource.data.devices.size() <= 25
        && (!('wallet' in request.resource.data) || (request.resource.data.wallet is map && request.resource.data.wallet.size() <= 25))
        && smallString(request.resource.data, 'owned', 4000)
        && smallString(request.resource.data, 'shared', 40000)
        && smallString(request.resource.data, 'dailyStats', 4000)
        && smallString(request.resource.data, 'practiceStats', 4000)
        && smallString(request.resource.data, 'daily', 8000)
        && smallString(request.resource.data, 'wordbook', 150000);
      allow delete: if signedIn() && me() == uid;
    }

    // ---- Challenges: one word, played separately by two friends. ----
    match /challenges/{id} {
      allow get, list: if signedIn() && me() in resource.data.players;
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.players == [me(), request.resource.data.to]
        && request.resource.data.to != me()
        && areFriends(me(), request.resource.data.to)
        && request.resource.data.answer is string && request.resource.data.answer.size() == 5
        && request.resource.data.keys().hasOnly(['from', 'to', 'players', 'answer', 'createdAt', 'results'])
        && request.resource.data.results.keys().size() == 0;
      // Each player may only add or change their own result.
      allow update: if signedIn() && me() in resource.data.players
        && onlyChanged(['results'])
        && request.resource.data.results.diff(resource.data.results).affectedKeys().hasOnly([me()]);
      allow delete: if false;
    }

    // ---- Word Swap: friends take turns picking a word for each other. ----
    match /swaps/{id} {
      function isPlayer() { return signedIn() && me() in resource.data.players; }
      function next() { return request.resource.data; }
      function scoreTotal(d) { return d.scores[d.players[0]] + d.scores[d.players[1]]; }
      // The picker chooses a word.
      function picks() {
        return resource.data.state == 'picking' && resource.data.setter == me()
          && onlyChanged(['state', 'word', 'guesses', 'live', 'nudge', 'updatedAt'])
          && next().state == 'guessing'
          && next().word is string && next().word.matches('^[a-z]{5}$')
          && next().guesses.size() == 0 && next().live == '';
      }
      // The guesser types (live) and submits guesses one at a time; earlier guesses never change.
      function guesses() {
        return resource.data.state == 'guessing' && resource.data.guesser == me()
          && onlyChanged(['guesses', 'live', 'updatedAt'])
          && next().guesses is list && next().guesses.size() <= 6
          && next().guesses.size() >= resource.data.guesses.size()
          && next().guesses.size() <= resource.data.guesses.size() + 1
          && (resource.data.guesses.size() == 0
            || next().guesses[0:resource.data.guesses.size()] == resource.data.guesses)
          && next().live is string && next().live.size() <= 5;
      }
      // The guesser ends the round: roles swap, the round advances, 1–6 points are added.
      function finishes() {
        return resource.data.state == 'guessing' && resource.data.guesser == me()
          && onlyChanged(['round', 'scores', 'setter', 'guesser', 'state', 'word', 'guesses', 'live', 'history', 'nudge', 'updatedAt'])
          && next().state == 'picking'
          && next().round == resource.data.round + 1
          && next().setter == resource.data.guesser && next().guesser == resource.data.setter
          && next().word == null && next().guesses.size() == 0
          && next().history is list && next().history.size() <= 30
          && next().scores.keys().hasOnly(resource.data.players)
          && next().scores[resource.data.players[0]] >= resource.data.scores[resource.data.players[0]]
          && next().scores[resource.data.players[1]] >= resource.data.scores[resource.data.players[1]]
          && scoreTotal(next()) - scoreTotal(resource.data) >= 1
          && scoreTotal(next()) - scoreTotal(resource.data) <= 6;
      }
      function nudges() {
        return onlyChanged(['nudge']) && next().nudge.by == me() && next().nudge.at is int;
      }

      allow get, list: if isPlayer();
      allow create: if signedIn()
        && next().keys().hasOnly(['players', 'createdAt', 'updatedAt', 'round', 'scores', 'setter', 'guesser', 'state', 'word', 'guesses', 'live', 'history', 'nudge'])
        && next().players == [me(), next().guesser]
        && next().guesser != me()
        && areFriends(me(), next().guesser)
        && next().setter == me()
        && next().state == 'picking' && next().round == 1 && next().word == null
        && next().guesses.size() == 0 && next().history.size() == 0
        && next().scores.keys().hasOnly([me(), next().guesser]) && next().scores.size() == 2
        && next().scores[me()] == 0 && next().scores[next().guesser] == 0;
      allow update: if isPlayer() && (picks() || guesses() || finishes() || nudges());
      // Either player can end the match.
      allow delete: if isPlayer();
    }

    // ---- Gifts between friends: coins or a shop item, opened once by the recipient. ----
    match /gifts/{id} {
      function gift() { return request.resource.data; }
      allow get, list: if signedIn() && (resource.data.to == me() || resource.data.from == me());
      allow create: if signedIn()
        && gift().from == me()
        && gift().to is string && gift().to != me()
        && areFriends(me(), gift().to)
        && gift().createdAt is int
        && gift().claimed == false
        && ((gift().kind == 'coins'
              && gift().keys().hasOnly(['from', 'to', 'kind', 'coins', 'createdAt', 'claimed'])
              && gift().coins in [50, 100, 250, 500])
          || (gift().kind == 'item'
              && gift().keys().hasOnly(['from', 'to', 'kind', 'item', 'createdAt', 'claimed'])
              && gift().item is string && gift().item.matches('^[a-z]+:[a-z0-9-]{1,40}$')));
      // Only the recipient opens it, once.
      allow update: if signedIn() && resource.data.to == me()
        && resource.data.claimed == false
        && onlyChanged(['claimed']) && gift().claimed == true;
      allow delete: if false;
    }

    // ---- Live races. ----
    match /races/{id} {
      allow get, list: if signedIn() && me() in resource.data.players;
      allow create: if signedIn()
        && request.resource.data.host == me()
        && request.resource.data.players == [me(), request.resource.data.guest]
        && request.resource.data.guest != me()
        && areFriends(me(), request.resource.data.guest)
        && request.resource.data.state == 'invited'
        && request.resource.data.answer is string && request.resource.data.answer.size() == 5
        && request.resource.data.keys().hasOnly(['host', 'guest', 'players', 'answer', 'state', 'createdAt', 'startAt', 'progress', 'winner'])
        && request.resource.data.progress.keys().size() == 0
        && request.resource.data.winner == null;
      // Participants can move the race along and update their own progress only.
      allow update: if signedIn() && me() in resource.data.players
        && onlyChanged(['state', 'startAt', 'progress', 'winner'])
        && request.resource.data.state in ['invited', 'countdown', 'playing', 'finished', 'declined', 'cancelled']
        && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([me()]);
      allow delete: if false;
    }
  }
}
